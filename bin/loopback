#!/usr/bin/env bash
set -Eeuo pipefail

export PATH="$HOME/.local/bin:$PATH"

CFG="${LOOPBACK_CONFIG_DIR:-$HOME/.config/loopback}"
CONF="$CFG/config.env"
LOG="$CFG/server.log"
PID="$CFG/server.pid"
VENV="$CFG/venv"
TOKEN="$CFG/token"
SERVER="$CFG/server.py"
TUNNEL_PID="$CFG/tunnel.pid"
POLICY="$CFG/policy.json"
NODES="$CFG/nodes.json"

[[ -f "$CONF" ]] || { echo "Loopback is not installed. Run ./install.sh"; exit 1; }
# shellcheck disable=SC1090
source "$CONF"

lower(){ printf '%s' "$1" | tr '[:upper:]' '[:lower:]'; }
die(){ printf '✗ %s\n' "$*" >&2; exit 1; }
ok(){ printf '✓ %s\n' "$*"; }

owned_server(){
  local p="${1:-}"
  [[ -n "$p" ]] && kill -0 "$p" 2>/dev/null || return 1
  local c
  c="$(tr '\0' ' ' < "/proc/$p/cmdline" 2>/dev/null || true)"
  [[ "$c" == *"uvicorn server:app"* && "$c" == *"$CFG"* ]]
}

stop_server(){
  if [[ -s "$PID" ]]; then
    local p
    p="$(cat "$PID" 2>/dev/null || true)"
    if owned_server "$p"; then
      kill "$p" 2>/dev/null || true
      for _ in $(seq 1 40); do kill -0 "$p" 2>/dev/null || break; sleep .1; done
    fi
  fi
  rm -f "$PID"
}

start_server(){
  mkdir -p "$CFG"
  printf '%s\n' "$LOOPBACK_PUBLIC_HOST" > "$CFG/public_host"
  export LOOPBACK_LOCAL_PORT="$LOOPBACK_PORT"
  export LOOPBACK_COMMAND_TIMEOUT="$LOOPBACK_TIMEOUT"
  export LOOPBACK_MAX_OUTPUT_BYTES="$LOOPBACK_MAX_OUTPUT_BYTES"
  export LOOPBACK_ACCESS_MODE="${LOOPBACK_ACCESS_MODE:-standard}"
  export LOOPBACK_INGRESS="${LOOPBACK_INGRESS:-local}"
  export LOOPBACK_SHELL="${LOOPBACK_SHELL:-${SHELL:-/bin/sh}}"
  : > "$LOG"
  nohup "$VENV/bin/python" -m uvicorn server:app --app-dir "$CFG"     --host 127.0.0.1 --port "$LOOPBACK_PORT"     --proxy-headers --forwarded-allow-ips=127.0.0.1     --log-level info >"$LOG" 2>&1 &
  echo $! > "$PID"
  for _ in $(seq 1 $((LOOPBACK_STARTUP_TIMEOUT*4))); do
    curl -fsS "http://127.0.0.1:$LOOPBACK_PORT/healthz" >/dev/null 2>&1 && return 0
    sleep .25
  done
  tail -80 "$LOG" >&2 || true
  die "server failed to start"
}

start_cloudflare(){
  command -v cloudflared >/dev/null 2>&1 || die "cloudflared is not installed"
  local cf_log="$CFG/cloudflared.log"
  if [[ -n "${LOOPBACK_CLOUDFLARE_TOKEN_FILE:-}" && -s "$LOOPBACK_CLOUDFLARE_TOKEN_FILE" ]]; then
    nohup cloudflared tunnel run --token-file "$LOOPBACK_CLOUDFLARE_TOKEN_FILE" >"$cf_log" 2>&1 &
  else
    [[ -n "${LOOPBACK_CLOUDFLARE_TUNNEL_ID:-}" ]] || die "Cloudflare tunnel is not configured"
    [[ -s "$CFG/cloudflared.yml" ]] || die "Cloudflare local tunnel config is missing"
    nohup cloudflared tunnel --config "$CFG/cloudflared.yml" run "$LOOPBACK_CLOUDFLARE_TUNNEL_ID" >"$cf_log" 2>&1 &
  fi
  echo $! > "$TUNNEL_PID"
}

stop_cloudflare(){
  [[ -s "$TUNNEL_PID" ]] || return 0
  local p
  p="$(cat "$TUNNEL_PID" 2>/dev/null || true)"
  [[ -n "$p" ]] && kill "$p" 2>/dev/null || true
  rm -f "$TUNNEL_PID"
}

start_tailscale(){
  command -v tailscale >/dev/null 2>&1 || die "tailscale is not installed"
  tailscale funnel --bg --https="${LOOPBACK_TAILSCALE_HTTPS_PORT:-443}" "http://127.0.0.1:$LOOPBACK_PORT" >/dev/null
}

stop_tailscale(){
  command -v tailscale >/dev/null 2>&1 || return 0
  tailscale funnel reset >/dev/null 2>&1 || true
}

start_ingress(){
  case "$(lower "${LOOPBACK_INGRESS:-local}")" in
    cloudflare) start_cloudflare ;;
    tailscale) start_tailscale ;;
    local|none) ;;
    *) die "unknown ingress: $LOOPBACK_INGRESS" ;;
  esac
}

stop_ingress(){
  case "$(lower "${LOOPBACK_INGRESS:-local}")" in
    cloudflare) stop_cloudflare ;;
    tailscale) stop_tailscale ;;
    local|none) ;;
  esac
}

up(){
  stop_server
  start_server
  start_ingress
  ok "Loopback is up"
  printf '  local:      http://127.0.0.1:%s/mcp\n' "$LOOPBACK_PORT"
  printf '  dashboard: http://127.0.0.1:%s/admin\n' "$LOOPBACK_PORT"
  if [[ "${LOOPBACK_INGRESS:-local}" != "local" ]]; then
    printf '  public:     https://%s/mcp\n' "$LOOPBACK_PUBLIC_HOST"
    printf '  admin:      https://%s/admin\n' "$LOOPBACK_PUBLIC_HOST"
  fi
}

down(){ stop_ingress; stop_server; ok "Loopback is down"; }
restart(){ down || true; up; }

status(){
  local state=DOWN p=""
  [[ -s "$PID" ]] && p="$(cat "$PID" 2>/dev/null || true)"
  owned_server "$p" && state=UP || true
  printf 'loopback: %s%s\n' "$state" "${p:+ (PID $p)}"
  printf '  profile:   %s\n' "$(policy_profile 2>/dev/null || printf '%s' "${LOOPBACK_ACCESS_MODE:-standard}")"
  printf '  ingress:   %s\n' "${LOOPBACK_INGRESS:-local}"
  printf '  local:     http://127.0.0.1:%s/mcp\n' "$LOOPBACK_PORT"
  printf '  dashboard: http://127.0.0.1:%s/admin\n' "$LOOPBACK_PORT"
  [[ "${LOOPBACK_INGRESS:-local}" == "local" ]] || {
    printf '  public:    https://%s/mcp\n' "$LOOPBACK_PUBLIC_HOST"
    printf '  admin:     https://%s/admin\n' "$LOOPBACK_PUBLIC_HOST"
  }
  printf '  timeout:   %ss\n' "$LOOPBACK_TIMEOUT"
  printf '  maxout:    %s bytes\n' "$LOOPBACK_MAX_OUTPUT_BYTES"
}

doctor(){
  echo "== Loopback doctor =="
  [[ -x "$VENV/bin/python" ]] && ok "python venv" || echo "✗ python venv"
  [[ -f "$SERVER" ]] && ok "server runtime" || echo "✗ server runtime"
  [[ -f "$CFG/policy.py" && -f "$CFG/jobs.py" && -f "$CFG/nodes.py" ]] && ok "v3 runtime modules" || echo "✗ v3 runtime modules"
  [[ -s "$TOKEN" ]] && ok "auth token" || echo "✗ auth token"
  command -v git >/dev/null 2>&1 && ok "git" || echo "• git not found"
  command -v ssh >/dev/null 2>&1 && ok "ssh fleet transport" || echo "• ssh not found"
  "$VENV/bin/python" -c 'import psutil' >/dev/null 2>&1 && ok "process telemetry" || echo "✗ psutil"
  case "$(lower "${LOOPBACK_INGRESS:-local}")" in
    cloudflare) command -v cloudflared >/dev/null 2>&1 && ok "cloudflared" || echo "✗ cloudflared" ;;
    tailscale) command -v tailscale >/dev/null 2>&1 && ok "tailscale" || echo "✗ tailscale" ;;
  esac
  curl -fsS "http://127.0.0.1:$LOOPBACK_PORT/healthz" >/dev/null 2>&1 && ok "local health" || echo "✗ local health"
  [[ "${LOOPBACK_INGRESS:-local}" == "local" ]] || {
    curl -fsS --max-time 15 "https://$LOOPBACK_PUBLIC_HOST/healthz" >/dev/null 2>&1 && ok "public health" || echo "✗ public health"
  }
}

logs(){
  if [[ "${1:-}" == "-f" || "${1:-}" == "--follow" ]]; then exec tail -f "$LOG"; fi
  tail -n "${1:-100}" "$LOG" 2>/dev/null || true
}

url(){
  if [[ "${LOOPBACK_INGRESS:-local}" == "local" ]]; then
    printf 'http://127.0.0.1:%s/mcp\n' "$LOOPBACK_PORT"
  else
    printf 'https://%s/mcp\n' "$LOOPBACK_PUBLIC_HOST"
  fi
}

dashboard(){
  if [[ "${LOOPBACK_INGRESS:-local}" == "local" ]]; then
    printf 'http://127.0.0.1:%s/admin\n' "$LOOPBACK_PORT"
  else
    printf 'https://%s/admin\n' "$LOOPBACK_PUBLIC_HOST"
  fi
}

token(){ cat "$TOKEN"; echo; }

rotate_token(){
  umask 077
  python3 - <<'PY' > "$TOKEN"
import secrets
print(secrets.token_hex(32))
PY
  chmod 600 "$TOKEN"
  restart
  ok "token rotated; OAuth/admin sessions were invalidated by restart"
}

config(){
  local action="$(lower "${1:-list}")"; shift || true
  case "$action" in
    list) cat "$CONF" ;;
    get) grep -E "^${1:?key}=" "$CONF" || true ;;
    set)
      local key="${1:?key}" value="${2:?value}"
      python3 - "$CONF" "$key" "$value" <<'PY'
from pathlib import Path
import sys
p=Path(sys.argv[1]); k=sys.argv[2]; v=sys.argv[3]
lines=p.read_text().splitlines()
out=[]; done=False
for line in lines:
    if line.startswith(k+"="):
        out.append(k+"="+v); done=True
    else:
        out.append(line)
if not done: out.append(k+"="+v)
p.write_text("\n".join(out)+"\n")
PY
      ok "saved $key"
      ;;
    *) die "config list|get KEY|set KEY VALUE" ;;
  esac
}

policy_profile(){
  [[ -s "$POLICY" ]] || { echo "standard"; return; }
  python3 - "$POLICY" <<'PY'
import json,sys
print(json.load(open(sys.argv[1])).get("profile","standard"))
PY
}

policy(){
  local action="$(lower "${1:-show}")"; shift || true
  case "$action" in
    show|list)
      [[ -s "$POLICY" ]] && cat "$POLICY" || echo '{"profile":"standard"}'
      ;;
    profile)
      local value="${1:?read-only|standard|trusted}"
      case "$value" in read-only|standard|trusted) ;; *) die "profile must be read-only, standard, or trusted" ;; esac
      "$VENV/bin/python" - "$CFG" "$value" <<'PY'
import sys
sys.path.insert(0,sys.argv[1])
from policy import Policy
print(Policy().set_profile(sys.argv[2]))
PY
      ok "policy profile set to $value"
      ;;
    tool)
      local name="${1:?tool name}" state="$(lower "${2:?on|off}")"
      [[ "$state" == on || "$state" == off ]] || die "tool state must be on or off"
      "$VENV/bin/python" - "$CFG" "$name" "$state" <<'PY'
import sys
sys.path.insert(0,sys.argv[1])
from policy import Policy
Policy().set_tool(sys.argv[2],sys.argv[3]=="on")
PY
      ok "$name $state"
      ;;
    *) die "policy show|profile PROFILE|tool NAME on|off" ;;
  esac
}

node(){
  local action="$(lower "${1:-list}")"; shift || true
  case "$action" in
    list)
      "$VENV/bin/python" - "$CFG" <<'PY'
import json,sys
sys.path.insert(0,sys.argv[1])
from nodes import NodeRegistry
print(json.dumps(NodeRegistry().list(),indent=2))
PY
      ;;
    add)
      local name="${1:?name}" target="${2:?ssh target}"
      "$VENV/bin/python" - "$CFG" "$name" "$target" <<'PY'
import json,sys
sys.path.insert(0,sys.argv[1])
from nodes import NodeRegistry
print(json.dumps(NodeRegistry().upsert({"name":sys.argv[2],"transport":"ssh","target":sys.argv[3]}),indent=2))
PY
      ok "node $name saved"
      ;;
    remove)
      local name="${1:?name}"
      "$VENV/bin/python" - "$CFG" "$name" <<'PY'
import sys
sys.path.insert(0,sys.argv[1])
from nodes import NodeRegistry
NodeRegistry().remove(sys.argv[2])
PY
      ok "node $name removed"
      ;;
    health)
      local name="${1:?name}"
      "$VENV/bin/python" - "$CFG" "$name" "${LOOPBACK_SHELL:-${SHELL:-/bin/sh}}" <<'PY'
import json,sys
sys.path.insert(0,sys.argv[1])
from nodes import NodeRegistry
print(json.dumps(NodeRegistry().health(sys.argv[2],sys.argv[3]),indent=2))
PY
      ;;
    *) die "node list|add NAME SSH_TARGET|remove NAME|health NAME" ;;
  esac
}

autostart(){
  local action="$(lower "${1:-status}")"
  local unit_dir="$HOME/.config/systemd/user"
  local unit="$unit_dir/loopback.service"
  case "$action" in
    on|enable)
      mkdir -p "$unit_dir"
      cat > "$unit" <<EOF
[Unit]
Description=Loopback MCP bridge
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/loopback up
ExecStop=%h/.local/bin/loopback down
TimeoutStartSec=180
TimeoutStopSec=30

[Install]
WantedBy=default.target
EOF
      systemctl --user daemon-reload
      systemctl --user enable --now loopback.service
      if command -v loginctl >/dev/null 2>&1 && sudo -n true >/dev/null 2>&1; then
        sudo loginctl enable-linger "$(id -un)" >/dev/null 2>&1 || true
      fi
      ok "autostart enabled"
      ;;
    off|disable)
      systemctl --user disable --now loopback.service 2>/dev/null || true
      rm -f "$unit"
      systemctl --user daemon-reload 2>/dev/null || true
      ok "autostart disabled"
      ;;
    status)
      if systemctl --user is-enabled --quiet loopback.service 2>/dev/null; then echo "autostart: enabled"; else echo "autostart: disabled"; fi
      systemctl --user status loopback.service --no-pager 2>/dev/null || true
      ;;
    *) die "autostart on|off|status" ;;
  esac
}

help(){
cat <<'EOF'
LOOPBACK

Lifecycle
  loopback up|down|restart|status|doctor
  loopback logs [N|-f]
  loopback url
  loopback dashboard
  loopback autostart on|off|status

Authentication
  loopback token
  loopback rotate-token

Policy
  loopback policy show
  loopback policy profile read-only|standard|trusted
  loopback policy tool NAME on|off

Fleet
  loopback node list
  loopback node add NAME SSH_TARGET
  loopback node remove NAME
  loopback node health NAME

Configuration
  loopback config list|get|set

MCP capabilities
  Files: read/write/list/patch/search/tail
  Git: git_info
  Jobs: command_run, command_start, job_list/output/stop, task_run
  Terminal: terminal_start/list/write/read/close
  Processes: process_list/info/kill
  Fleet: node_list/health/command/copy
  Observability: system_snapshot, diagnostics, machine_info, policy_status

Powerful tools are present but disabled by standard/read-only policy unless
the operator explicitly enables them or chooses the trusted profile.
EOF
}

cmd="$(lower "${1:-help}")"; shift || true
case "$cmd" in
  up) up "$@" ;;
  down) down "$@" ;;
  restart) restart "$@" ;;
  status) status "$@" ;;
  doctor) doctor "$@" ;;
  logs) logs "$@" ;;
  url) url ;;
  dashboard) dashboard ;;
  token) token ;;
  rotate-token|rotatetoken) rotate_token ;;
  config) config "$@" ;;
  policy) policy "$@" ;;
  node|nodes) node "$@" ;;
  autostart) autostart "$@" ;;
  help|-h|--help) help ;;
  *) die "unknown command: $cmd" ;;
esac
