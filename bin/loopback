#!/usr/bin/env bash
# Loopback CLI wrapper. The real implementation is cli.py (Python); this file
# only locates it so Linux, macOS and Windows behave identically.
#
#   installed:        exec <cfg>/venv/bin/python <cfg>/cli.py "$@"
#   source checkout:  loopback install ...  ->  python3 <repo>/runtime/cli.py install ...
set -eu

if [ -n "${LOOPBACK_CONFIG_DIR:-}" ]; then
  CFG="$LOOPBACK_CONFIG_DIR"
elif [ -n "${XDG_CONFIG_HOME:-}" ]; then
  CFG="$XDG_CONFIG_HOME/loopback"
else
  CFG="$HOME/.config/loopback"
fi

PY="$CFG/venv/bin/python"
if [ ! -x "$PY" ] && [ -s "$CFG/python-override" ]; then
  # Test-only installs (cli.py install --skip-venv) record their interpreter here.
  PY="$(cat "$CFG/python-override")"
fi

if [ -x "$PY" ] && [ -f "$CFG/cli.py" ]; then
  exec "$PY" "$CFG/cli.py" "$@"
fi

if [ "${1:-}" = "install" ]; then
  shift
  SOURCE="${BASH_SOURCE[0]}"
  while [ -h "$SOURCE" ]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    case "$SOURCE" in /*) ;; *) SOURCE="$DIR/$SOURCE" ;; esac
  done
  ROOT="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"
  if [ -f "$ROOT/runtime/cli.py" ]; then
    command -v python3 >/dev/null 2>&1 || { echo "loopback: python3 (3.11+) is required" >&2; exit 1; }
    exec python3 "$ROOT/runtime/cli.py" install "$@"
  fi
fi

if [ -f "$CFG/server.py" ] && [ ! -f "$CFG/cli.py" ]; then
  echo "loopback: a Loopback v3 runtime is installed in $CFG but the v4 CLI is missing." >&2
  echo "          Upgrade it with ./install.sh from a Loopback v4 checkout or release." >&2
  exit 1
fi

echo "loopback: not installed (looked in $CFG)." >&2
echo "  Install:  curl -fsSL https://github.com/p5n-n3t/loopback/releases/latest/download/install.sh | bash" >&2
echo "       or:  git clone https://github.com/p5n-n3t/loopback && cd loopback && ./install.sh" >&2
exit 1
